# ───── Sistema operativo ─────
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# ───── Editores / IDEs ─────
.vscode/
.idea/
*.swp
*.swo
*~

# ───── Backups locales (NO deben ir al repo) ─────
*-BACKUP-*/
backup-*/
*.bak
*.orig

# ───── Compresiones de distribución local ─────
*.zip
*.rar
*.7z

# ───── Logs y caches ─────
*.log
logs/
cache/
tmp/

# ───── Archivos rotos conocidos ─────
# "images" en la raíz es un junction/symlink roto de 0 bytes (no es la carpeta
# real de imágenes; la buena está en assets/images/).
/images

# ───── Node / build (por si alguien añade tooling) ─────
node_modules/
dist/
build/

# ───── Configuración con credenciales (NUNCA debe ir al repo) ─────
# El config.php real contiene credenciales de BD, JWT_SECRET y datos
# sensibles. Cada instalación debe tener su propio config.php derivado
# de config.example.php (que SÍ va al repo, con placeholders).
backend/config/config.php

# ───── Fotos subidas por usuarios (datos de prueba) ─────
# Las fotos las suben los usuarios del sistema en runtime; no son código.
assets/fotos/u*

# ───── Exports SQL temporales / fallidos ─────
EXPORT_*.sql
backend/sql/EXPORT_*.sql

# ───── Generadores temporales y entregables locales ─────
generar_requerimientos_pdf.py
NUV-Requerimientos-*.pdf
prestamo-laboratorios-front-*.zip
